# Copy to .env and edit. Defaults run fully offline with no keys/downloads/Docker.
LLM_PROVIDER=mock            # mock | openai | anthropic | ollama
EMBEDDINGS=hashing           # hashing | sentence-transformers | openai
VECTOR_STORE=memory          # memory | qdrant

# Ingestion / retrieval
INGEST_DIR=data/sample_docs
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# --- Real vector database (Qdrant, run via Docker) ---
# VECTOR_STORE=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=rag_docs
# QDRANT_RECREATE=true        # recreate collection on startup (deterministic demo)

# --- Real answer model ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1

# --- Real embeddings ---
# EMBEDDINGS=sentence-transformers        # pip install -r requirements-optional.txt
# ST_MODEL=all-MiniLM-L6-v2
#
# EMBEDDINGS=openai
# OPENAI_EMBED_MODEL=text-embedding-3-small
